# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Postgres ---
POSTGRES_USER=aureum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aureum
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- LiveKit ---
# IP that clients use to reach the media server.
# 127.0.0.1 for local-only tests; your LAN IP to test from other PCs; the VM public IP in production.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_API_KEY=change-me
# Must be at least 32 characters.
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-32chars-min
LIVEKIT_URL=ws://localhost:7880
# Optional: how the API container reaches LiveKit's server API (voice moderation), when it
# can't use LIVEKIT_URL. With the local-livekit profile: http://livekit:7880
# LIVEKIT_API_URL=

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=aureum
# Must be at least 8 characters.
MINIO_ROOT_PASSWORD=change-me-please
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aureum

# --- API ---
# Secret used to sign JWTs. Generate a long random value.
JWT_SECRET=change-me-to-a-long-random-secret
API_PORT=8000
# Largest file (in MB) people can send in a conversation.
MAX_ATTACHMENT_MB=25

# Public address of the API (the Tailscale Funnel URL, e.g. https://<machine>.<tailnet>.ts.net).
# Used for invite links (/convite/<code>) and the images in e-mails.
PUBLIC_BASE_URL=http://localhost:8000
# The landing page's origin: the only one that may read GET /api/public/stats (empty = none).
PUBLIC_SITE_ORIGIN=https://eduoliveira1504.github.io

# --- GIFs (Klipy, free) ---
# App key from the Klipy Partner Panel (partner.klipy.com). Empty = no GIF button in the app.
# Klipy's rules have the app call it directly, so this key reaches the app: it's a client key.
KLIPY_APP_KEY=

# --- Beta ---
# Username of the app owner's personal account: reads bug reports, gets the Founder badge.
AUREUM_OWNER_USERNAME=
# While true, accounts that confirm their e-mail get the numbered beta badge (Pioneiro).
AUREUM_BETA=false
# Pioneiro numbers go up to this one (reserved numbers count); past it, nobody else gets it.
AUREUM_PIONEER_LIMIT=20
# While true, signing up needs an account invite. Independent from AUREUM_BETA.
AUREUM_INVITE_ONLY=true

# --- E-mail (account codes, welcome, security notices) ---
# "smtp" sends for real. Free option: a dedicated Gmail account with 2-step verification and an
# app password (Google Account > Security > App passwords); ~500 e-mails/day.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = TLS from the start.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender address; the name shown is always "Aureum".
EMAIL_FROM=

# --- Server moved (block 3.18) ---
# The new server's address (e.g. https://api.aureum-voice.duckdns.org). Set on the OLD server only:
# it answers 503 "O Aureum mudou de servidor. Atualize o app." everywhere but /api/health, closes
# WebSockets with that message and redirects /convite/... there. Empty = normal.
# SERVER_MOVED_TO=

# --- VPS production only (infra/docker-compose.prod.yml) ---
# Base name Caddy serves: api.<domain> (API), live.<domain> (LiveKit). There, LIVEKIT_URL is
# wss://live.<domain> and PUBLIC_BASE_URL is https://api.<domain>.
# AUREUM_DOMAIN=aureum-voice.duckdns.org

# --- Desktop releases (npm run release in apps/desktop) ---
# Fine-grained GitHub token for this repository only, with "Contents: read and write".
# GH_TOKEN=
