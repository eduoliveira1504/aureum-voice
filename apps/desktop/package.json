{
  "name": "aureum-voice-desktop",
  "productName": "Aureum Voice",
  "version": "0.1.0",
  "description": "Aureum Voice desktop client",
  "author": "Eduardo Oliveira",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "sounds": "node ../../scripts/generate-sounds.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.x",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "livekit-client": "2.22.4",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "koffi": "3.3.2"
  }
}
