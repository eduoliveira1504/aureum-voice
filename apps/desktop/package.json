{
  "name": "aureum-voice-desktop",
  "productName": "Aureum Voice",
  "version": "0.2.0-beta.6",
  "description": "Aureum Voice desktop client",
  "author": "Eduardo Oliveira",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "sounds": "node ../../scripts/generate-sounds.mjs",
    "email-images": "electron ../../scripts/generate-email-images.mjs",
    "og-image": "electron ../../scripts/generate-og-image.mjs",
    "build:icons": "electron ../../scripts/build-icons.mjs",
    "build:stickers": "electron ../../scripts/build-stickers.mjs",
    "release": "node ../../scripts/release-desktop.mjs"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@twemoji/svg": "15.0.0",
    "@types/node": "24.x",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "emojibase-data": "18.0.0",
    "jsdom": "30.1.3",
    "livekit-client": "2.22.4",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "3.3.2"
  }
}
